# Build outputs
build/
out/
bin/
obj/
*.o
*.so
*.a
*.ko
# Preprocessor / assembly outputs
*.i
*.s

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# CMake (generated)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
# project Makefiles are tracked; only ignore generated ones
build/Makefile
out/Makefile

# Python
__pycache__/
*.pyc
.venv/
venv/

# DPDK
*.core

# Debug
core
*.core-dump

# Archives
*.tar.gz
*.zip
*.tgz

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Compiled lab binaries (no extension, asan/fixed/ubsan variants)
*-asan
*-ubsan
*-fixed

# Ignore compiled binaries in my-lab: block everything without an extension,
# then un-ignore source files by their extensions
phase*/week*/my-lab/*
!phase*/week*/my-lab/*/
phase*/week*/my-lab/**/*
!phase*/week*/my-lab/**/*.c
!phase*/week*/my-lab/**/*.h
!phase*/week*/my-lab/**/*.md
!phase*/week*/my-lab/**/*.sh
!phase*/week*/my-lab/**/Makefile
!phase*/week*/my-lab/**/README*
!phase*/week*/my-lab/**/NOTES*

# Sensitive
*.key
*.pem
*.p12
*.pfx
*.crt.env
# (CA/cert test fixtures committed intentionally)
